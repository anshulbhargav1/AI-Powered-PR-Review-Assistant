# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# --- Groq (LLM backing all 4 review agents) ---
# Free-tier key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com

# --- VCS mode ---
# "mock"  -> no live GitHub/GitLab credentials needed; comments are logged, and a fixed
#            illustrative diff is used so you can see all 4 agents run end-to-end.
# "live"  -> posts real comments using the tokens below.
VCS_MODE=mock

# --- GitHub (only needed when VCS_MODE=live) ---
GITHUB_TOKEN=
# Shared secret configured on the GitHub webhook (Settings > Webhooks). Leave blank to
# skip signature verification during local testing.
GITHUB_WEBHOOK_SECRET=

# --- GitLab (only needed when VCS_MODE=live) ---
GITLAB_TOKEN=
GITLAB_BASE_URL=https://gitlab.com
# Shared secret token configured on the GitLab webhook (Settings > Webhooks). Leave blank
# to skip token verification during local testing.
GITLAB_WEBHOOK_SECRET=

# --- Dashboard ---
# Used to build the link included in posted PR/MR comments.
DASHBOARD_BASE_URL=http://localhost:5173

# --- Temporal ---
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=pr-review-task-queue

# --- Misc ---
LOG_LEVEL=INFO
